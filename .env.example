# =============================================================
# FastAPI DevOps GCP — Environment Variables Reference
# Copy this file to .env for local development
# NEVER commit .env to source control
# =============================================================

# -------------------------------------------------------------
# Application
# -------------------------------------------------------------
APP_ENV=development                     # development | staging | production
APP_NAME="FastAPI DevOps GCP"
APP_VERSION=1.0.0
DEBUG=true                              # Set false in staging/production

# -------------------------------------------------------------
# API
# -------------------------------------------------------------
API_V1_PREFIX=/api/v1
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# -------------------------------------------------------------
# Security / JWT
# -------------------------------------------------------------
JWT_SECRET_KEY=your-super-secret-key-min-32-chars-long-change-this
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# -------------------------------------------------------------
# Database (PostgreSQL)
# For Cloud Run with Cloud SQL: postgresql+asyncpg:///dbname?host=/cloudsql/PROJECT:REGION:INSTANCE
# For local dev: postgresql+asyncpg://user:password@localhost:5432/dbname
# -------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://fastapi_user:password@localhost:5432/fastapi_db
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Cloud SQL instance connection name (for Cloud Run deployment)
CLOUD_SQL_INSTANCE=your-project:asia-south1:fastapi-db-dev

# -------------------------------------------------------------
# Redis (Redis Cloud)
# Format: rediss://username:password@host:port (rediss:// for TLS)
# -------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_MAX_CONNECTIONS=10

# -------------------------------------------------------------
# GCP Storage
# -------------------------------------------------------------
GCS_PUBLIC_BUCKET=your-project-public-dev
GCS_PRIVATE_BUCKET=your-project-private-dev
GCS_SIGNED_URL_EXPIRATION_MINUTES=60
# Leave empty on Cloud Run (uses service account metadata server)
# Set path to service account JSON for local development
GOOGLE_APPLICATION_CREDENTIALS=

# -------------------------------------------------------------
# GCP Project
# -------------------------------------------------------------
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=asia-south1

# -------------------------------------------------------------
# GCP Cloud Logging (optional for local dev)
# -------------------------------------------------------------
# Set to true to send logs to GCP Cloud Logging (auto-enabled on Cloud Run)
ENABLE_GCP_LOGGING=false
LOG_LEVEL=DEBUG                        # DEBUG | INFO | WARNING | ERROR | CRITICAL
